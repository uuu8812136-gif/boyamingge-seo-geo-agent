# ──────────────────────────────────────────────────────────────
# 博雅敏格 SEO-GEO 双引擎智能体 — 环境变量模板
# 复制为 .env 后填入实际值；生产环境所有 ⚠️ 项必须修改
# ──────────────────────────────────────────────────────────────

# ── 运行环境 ──
APP_ENV=development                    # development|production（生产必须为 production）
SEED_DEMO_DATA=false                   # 仅自动化测试或本地演示时设为 true
MOCK_SCENARIO=empty                    # 未接真实数据源时不展示虚构指标
ALLOW_MOCK_PROVIDERS_IN_PRODUCTION=false
# ⚠️ 生产必须修改：长度≥32 的随机字符串，可用 `openssl rand -hex 32` 生成
JWT_SECRET_KEY=change-me-in-production

# ── 数据库 ──
# ⚠️ 生产必须修改密码
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=boyamingge
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/boyamingge

# ── Redis ──
REDIS_URL=redis://redis:6379/0
CUSTOMER_SERVICE_REDIS_URL=redis://redis:6379/1

# 首次生产启动且数据库无管理员时设置；创建成功后从部署环境移除
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# ── CORS 白名单（逗号分隔，生产必须改为具体域名）──
CORS_ORIGINS=*

# ── JWT / OAuth2 ──
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
OAUTH2_CLIENT_ID=boyamingge-client
# ⚠️ 生产必须修改
OAUTH2_CLIENT_SECRET=boyamingge-secret

# ── 外部 API 开关（无 Key 时保持 mock，功能可全流程测试）──
# LLM：mock=true 用本地模板；接 DeepSeek 时设 false 并填 DEEPSEEK_API_KEY
LLM_MOCK_MODE=true
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434

# 运营指标：mock=演示数据；live=百度统计/ClickHouse（需 BAIDU_TONGJI_TOKEN + BAIDU_TONGJI_SITE_ID）
METRICS_PROVIDER=mock
BAIDU_TONGJI_TOKEN=
BAIDU_TONGJI_SITE_ID=                      # 百度统计站点ID（live 模式必填）
# BAIDU_TONGJI_API_BASE=https://openapi.baidu.com/rest/2.0/tongji

# 热线外呼：mock=仅入库排队；live=天润融通（需 TIANRUN_API_KEY / TIANRUN_API_BASE / TIANRUN_AGENT_ID / TIANRUN_EXT_ID）
HOTLINE_PROVIDER=mock
TIANRUN_API_KEY=
TIANRUN_API_BASE=
TIANRUN_AGENT_ID=                          # 天润融通座席号（live 模式必填）
TIANRUN_EXT_ID=                            # 天润融通分机号（live 模式必填）

# 渠道分发：mock=不生成外链；live=生成 workbench / packages 真实链接
DISTRIBUTE_MODE=mock

# ── 业务阈值 ──
EEAT_THRESHOLD=70
PUBLISH_DAILY_LIMIT=3
PUBLISH_WEEKLY_LIMIT=15
TEMPLATE_SIMILARITY_LIMIT=0.70
NEW_SITE_PAGE_LIMIT=20
INTENT_CACHE_TTL_SECONDS=604800

# ── 站点 URL（⚠️ 生产必须改为实际域名）──
SITE_BASE_URL=http://localhost
WORKBENCH_BASE_URL=https://workbench.example.com
PACKAGES_BASE_URL=http://localhost/packages

# ── 上传限制 ──
UPLOAD_MAX_SIZE=20971520              # 20MB，单位字节

# ── 前端 ──
NEXT_PUBLIC_SITE_URL=http://localhost
NEXT_PUBLIC_API_URL=
INTERNAL_API_URL=http://fastapi:8000
# 本地 npm run dev 时 Next 代理后端（可选）
API_PROXY_TARGET=http://127.0.0.1:8000
AMAP_WEB_SERVICE_KEY=

# ── 二级域名多城市总部后台 ──
# 根域名（不含协议/www），用于解析城市二级域名 *.boyamingge.com
NEXT_PUBLIC_ROOT_DOMAIN=boyamingge.com
# 后台域名（城市子域名访问 /admin 时跳转目标）
NEXT_PUBLIC_ADMIN_URL=https://admin.boyamingge.com
# 官网站点域名（品牌总站）：生产建议 https://www.boyamingge.com
# NEXT_PUBLIC_SITE_URL=https://www.boyamingge.com
# API 域名（生产由 Nginx 转发到 FastAPI）
# NEXT_PUBLIC_API_URL=https://api.boyamingge.com
# 城市域名模式：subdomain（二级域名）| path（仅路径，MVP 兼容）
NEXT_PUBLIC_CITY_DOMAIN_MODE=subdomain
# 后端：是否开启 /{city} -> city.boyamingge.com 301（仅生产稳定后开启）
ENABLE_CITY_PATH_REDIRECT=false


# AI 客服接口预留（OpenAI-compatible 或自有网关均可）
# AI_CUSTOMER_SERVICE_API_URL=https://your-ai-gateway.example.com/v1/chat/completions
# AI_CUSTOMER_SERVICE_API_KEY=
# AI_CUSTOMER_SERVICE_MODEL=customer-service-default
FASTAPI_PORT=8000
