# ─── 生产环境配置模板 ───
# 复制为 .env.production 并填写真实值，绝不要把真实密钥提交到仓库

# 应用环境（生产必须为 production）
APP_ENV=production
SEED_DEMO_DATA=false
MOCK_SCENARIO=empty

# JWT 密钥（至少 32 位随机字符串，可用 openssl rand -hex 32 生成）
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_CHARS_RANDOM_STRING

# OAuth2 客户端密钥
OAUTH2_CLIENT_SECRET=REPLACE_WITH_STRONG_SECRET

# 数据库（生产用 PostgreSQL，不要用 SQLite）
DATABASE_URL=postgresql://USER:change-me-password@DB_HOST:5432/boyamingge
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# 首次启动且数据库没有管理员时必填；创建完成后可从部署环境移除
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_12_CHARS_PASSWORD
ALLOW_MOCK_PROVIDERS_IN_PRODUCTION=false

# CORS（生产不能用 *，列出真实域名）
CORS_ORIGINS=https://www.boyamingge.com,https://admin.boyamingge.com

# 站点地址
SITE_BASE_URL=https://www.boyamingge.com
NEXT_PUBLIC_SITE_URL=https://www.boyamingge.com
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_ROOT_DOMAIN=boyamingge.com

# 城市二级域名模式
NEXT_PUBLIC_CITY_DOMAIN_MODE=subdomain
ENABLE_CITY_PATH_REDIRECT=true

# ─── 第三方对接（按需切换 mock → live）───

# LLM 内容生成（mock=true 仅演示，不调用真实 AI）
LLM_MOCK_MODE=false
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=REPLACE_WITH_REAL_DEEPSEEK_KEY

# 运营指标（mock 返回演示数据）
METRICS_PROVIDER=live
BAIDU_TONGJI_TOKEN=REPLACE_WITH_REAL_TOKEN
BAIDU_TONGJI_SITE_ID=REPLACE_WITH_REAL_SITE_ID

# 热线外呼（mock 不会真实外呼）
HOTLINE_PROVIDER=live
TIANRUN_API_KEY=REPLACE_WITH_REAL_TIANRUN_KEY
TIANRUN_API_BASE=https://REPLACE_WITH_REAL_TIANRUN_HOST
TIANRUN_AGENT_ID=REPLACE_WITH_REAL_AGENT_ID
TIANRUN_EXT_ID=REPLACE_WITH_REAL_EXT_ID

# 渠道分发（mock 不会真实分发）
DISTRIBUTE_MODE=live
WORKBENCH_BASE_URL=https://workbench.boyamingge.com
PACKAGES_BASE_URL=https://packages.boyamingge.com

# ─── 其他 ───
# Redis（生产建议配置）
REDIS_URL=redis://REDIS_HOST:6379/0
CUSTOMER_SERVICE_REDIS_URL=redis://REDIS_HOST:6379/1

# 监控后台必须使用强密码
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_GRAFANA_PASSWORD

# 日志级别
LOG_LEVEL=INFO
