# ─── 前端生产环境配置模板 ───
# 复制为 .env.production 并填写真实值

# 站点地址（生产用 https）
NEXT_PUBLIC_SITE_URL=https://www.boyamingge.com

# 浏览器使用同源 /api，由 Nginx 转发到后端，避免跨域和混合内容
NEXT_PUBLIC_API_URL=
INTERNAL_API_URL=http://fastapi:8000
API_PROXY_TARGET=http://fastapi:8000
REDIS_URL=redis://redis:6379/1
AMAP_WEB_SERVICE_KEY=

# ── 二级域名多城市 ──
NEXT_PUBLIC_ROOT_DOMAIN=boyamingge.com
NEXT_PUBLIC_ADMIN_URL=https://admin.boyamingge.com
NEXT_PUBLIC_CITY_DOMAIN_MODE=subdomain
NEXT_PUBLIC_ENABLE_CITY_PATH_REDIRECT=true

# AI 客服接口预留（OpenAI-compatible 或自有网关均可）
# AI_CUSTOMER_SERVICE_API_URL=https://your-ai-gateway.example.com/v1/chat/completions
# AI_CUSTOMER_SERVICE_API_KEY=
# AI_CUSTOMER_SERVICE_MODEL=customer-service-default
