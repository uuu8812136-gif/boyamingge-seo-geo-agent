/* 个人中心页 · 博雅敏格品牌色 #1a365d */
.profile-page {
  min-height: 100vh;
  background: #f5f7fa;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 5rpx solid #e0e4ea;
  border-top-color: #1a365d;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #6b7280;
}

/* 头部用户信息卡片 - 深蓝色品牌背景 */
.header-card {
  background: linear-gradient(135deg, #1a365d 0%, #2a4a7f 100%);
  padding: 56rpx 32rpx 80rpx;
  color: #ffffff;
  position: relative;
  overflow: hidden;
}

.header-card::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.06);
}

.header-card::after {
  content: '';
  position: absolute;
  bottom: -40rpx;
  left: -40rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.04);
}

.user-info {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-right: 28rpx;
  flex-shrink: 0;
  border: 4rpx solid rgba(255,255,255,0.25);
}

.user-name {
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.user-role {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
}

/* 信息卡片 - 浮起效果 */
.info-card {
  margin: -48rpx 24rpx 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(26, 54, 93, 0.1);
  position: relative;
  z-index: 2;
}

.info-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a2332;
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
}

.info-label {
  font-size: 27rpx;
  color: #6b7a90;
}

.info-value {
  font-size: 27rpx;
  color: #1a2332;
  font-weight: 500;
}

/* 数据统计行 两列布局 */
.info-card .stats-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.info-card .stat-block {
  width: 50%;
  box-sizing: border-box;
  padding: 20rpx 0;
}

.info-card .stat-block:nth-child(odd) {
  padding-right: 20rpx;
}

.info-card .stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a365d;
  line-height: 1.1;
}

.info-card .stat-num.warn {
  color: #d97706;
}

.info-card .stat-num.success {
  color: #059669;
}

.info-card .stat-label {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #6b7a90;
}

/* 功能菜单 */
.menu-card {
  margin: 0 24rpx 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(26, 54, 93, 0.06);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #f0f2f5;
  background: #ffffff;
  transition: background 0.15s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item-hover {
  background: #f5f7fa !important;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
  width: 52rpx;
  text-align: center;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #1a2332;
  font-weight: 500;
}

.menu-arrow {
  font-size: 32rpx;
  color: #c0c8d8;
  font-weight: 300;
}

/* 退出登录按钮 */
.logout-btn {
  margin: 40rpx 24rpx 60rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 31rpx;
  font-weight: 500;
  color: #dc2626;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(26, 54, 93, 0.06);
}

.logout-btn-hover {
  background: #fef2f2 !important;
}

.version {
  text-align: center;
  font-size: 24rpx;
  color: #a0aec0;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}
