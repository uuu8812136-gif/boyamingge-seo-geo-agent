/* 素材上传页 */
.upload-page {
  min-height: 100vh;
  background: #f0f2f5;
  padding-bottom: 40rpx;
}

/* 头部提示区 */
.head-card {
  background: #1a365d;
  padding: 36rpx 32rpx;
  color: #ffffff;
}

.head-title {
  font-size: 34rpx;
  font-weight: 600;
}

.head-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  line-height: 1.6;
}

/* 上传按钮区 */
.upload-area {
  padding: 32rpx 24rpx 12rpx;
  display: flex;
  flex-wrap: wrap;
}

.upload-btn {
  width: calc(50% - 10rpx);
  height: 220rpx;
  border-radius: 16rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(26, 54, 93, 0.05);
  margin-bottom: 20rpx;
}

.upload-btn:first-child {
  margin-right: 20rpx;
}

.upload-btn-hover {
  background: #f5f7fa !important;
}

.upload-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.upload-label {
  font-size: 28rpx;
  color: #1a2332;
  font-weight: 500;
}

.upload-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8c95a6;
}

/* 素材网格 */
.grid-area {
  padding: 20rpx 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a2332;
  margin-bottom: 20rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.grid-item {
  width: calc(33.333% - 14rpx);
  margin-bottom: 20rpx;
  position: relative;
}

.grid-item:nth-child(3n+2) {
  margin-left: 20rpx;
  margin-right: 20rpx;
}

.media-wrap {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #e8ecf1;
}

.media-img {
  width: 100%;
  height: 100%;
}

.media-type-tag {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  background: rgba(26, 54, 93, 0.7);
  color: #fff;
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
}

.media-status {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 8rpx;
  text-align: center;
  font-size: 20rpx;
}

.status-pending { background: #fef3c7; color: #92400e; }
.status-approved { background: #d1fae5; color: #065f46; }
.status-rejected { background: #fee2e2; color: #991b1b; }

/* 加载中 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0 60rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 5rpx solid #e0e4ea;
  border-top-color: #1a365d;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #6b7280;
}

/* 空状态 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0 60rpx;
}

.empty-icon-box {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #e8ecf1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  font-size: 48rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #6b7280;
}
