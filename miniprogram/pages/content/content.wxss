/* 内容确认列表页 */
.content-page {
  min-height: 100vh;
  background: #f0f2f5;
  padding-bottom: 40rpx;
}

/* 顶部统计条 */
.stat-bar {
  background: #1a365d;
  padding: 32rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.2;
}

.stat-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.65);
}

.stat-divider {
  width: 1rpx;
  height: 52rpx;
  background: rgba(255, 255, 255, 0.15);
}

/* 状态筛选 Tab */
.tab-bar {
  display: flex;
  white-space: nowrap;
  background: #ffffff;
  padding: 0 12rpx;
  border-bottom: 1rpx solid #e8ecf1;
}

.tab-item {
  display: inline-block;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  color: #6b7280;
  position: relative;
}

.tab-active {
  color: #1a365d;
  font-weight: 600;
}

.tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 5rpx;
  background: #1a365d;
  border-radius: 3rpx;
}

/* 卡片列表 */
.card-list {
  padding: 20rpx 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(26, 54, 93, 0.05);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a2332;
  line-height: 1.4;
}

/* 标签横排 */
.tag-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  margin-right: 10rpx;
  margin-bottom: 6rpx;
  line-height: 1.5;
  display: inline-block;
}

.tag-city { background: #e8eef7; color: #1a365d; }
.tag-platform { background: #e3f2e8; color: #2e6b4f; }
.tag-type { background: #fdf2e0; color: #a67c00; }
.tag-tier { background: #eef0f4; color: #4a6280; }
.tag-eeat { background: #ede8f5; color: #5b4aaa; }

/* 内容预览 */
.preview {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #5a6475;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 卡片底部 */
.card-footer {
  margin-top: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-time {
  font-size: 22rpx;
  color: #8c95a6;
}

.status-pending { background: #fef3c7; color: #92400e; }
.status-package { background: #e0e7ff; color: #3730a3; }
.status-confirmed { background: #d1fae5; color: #065f46; }
.status-rejected { background: #fee2e2; color: #991b1b; }
.status-published { background: #dbeafe; color: #1e40af; }

/* 加载中 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 5rpx solid #e0e4ea;
  border-top-color: #1a365d;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #6b7280;
}

/* 空状态 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 0;
}

.empty-icon-box {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #e8ecf1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  font-size: 48rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #6b7280;
}
