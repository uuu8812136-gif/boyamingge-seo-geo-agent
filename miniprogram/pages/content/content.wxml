<view class="content-page">
  <view class="stat-bar" wx:if="{{stats}}">
    <view class="stat-item">
      <view class="stat-num">{{stats.pending}}</view>
      <view class="stat-label">待确认</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <view class="stat-num">{{stats.confirmed}}</view>
      <view class="stat-label">已确认</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <view class="stat-num">{{stats.total_leads}}</view>
      <view class="stat-label">总线索</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <view class="stat-num">{{stats.total_materials}}</view>
      <view class="stat-label">素材</view>
    </view>
  </view>

  <scroll-view class="tab-bar" scroll-x enable-flex>
    <view
      class="tab-item {{activeTab === item.key ? 'tab-active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onTabChange"
    >{{item.label}}</view>
  </scroll-view>

  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <view class="loading-text">加载中...</view>
  </view>

  <block wx:elif="{{!isEmpty}}">
    <view class="card-list">
      <view
        class="card"
        wx:for="{{list}}"
        wx:key="publication_id"
        data-id="{{item.publication_id}}"
        bindtap="onTapCard"
      >
        <view class="card-title">{{item.title}}</view>
        <view class="tag-row">
          <text class="tag tag-city">{{item.city}}</text>
          <text class="tag tag-platform">{{item.platform}}</text>
          <text class="tag tag-type">{{item.content_type}}</text>
          <text class="tag tag-tier">{{item.tier}}</text>
          <text class="tag tag-eeat" wx:if="{{item.eeat_score}}">EEAT {{item.eeat_score}}</text>
        </view>
        <view class="preview">{{item.markdown_preview}}</view>
        <view class="card-footer">
          <view class="card-time" wx:if="{{item.created_at}}">{{item.created_at}}</view>
          <text class="tag {{item.statusClass}}">{{item.statusLabel}}</text>
        </view>
      </view>
    </view>
  </block>

  <view class="empty-wrap" wx:else>
    <view class="empty-icon-box">📋</view>
    <view class="empty-text">暂无内容</view>
  </view>
</view>
