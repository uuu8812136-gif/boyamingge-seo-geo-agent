/* 线索管理页 */
.leads-page {
  min-height: 100vh;
  background: #f0f2f5;
  padding-bottom: 40rpx;
}

/* 顶部统计卡片 */
.stat-card {
  background: #1a365d;
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.2;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.15);
}

/* 列表区域 */
.list-area {
  padding: 20rpx 24rpx;
}

.lead-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(26, 54, 93, 0.05);
}

.lead-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.lead-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a2332;
}

.status-new { background: #dbeafe; color: #1e40af; }
.status-assigned { background: #e0e7ff; color: #3730a3; }
.status-contacted { background: #fef3c7; color: #92400e; }
.status-converted { background: #d1fae5; color: #065f46; }

.lead-info {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #5a6475;
  line-height: 1.8;
}

.info-row {
  margin-bottom: 4rpx;
}

.info-label {
  color: #8c95a6;
  margin-right: 8rpx;
}

.lead-note {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: #f8f9fb;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #5a6475;
}

.lead-time {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #8c95a6;
}

/* 操作区 */
.lead-actions {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f2f5;
}

.action-label {
  font-size: 24rpx;
  color: #8c95a6;
  margin-bottom: 12rpx;
}

.action-btns {
  display: flex;
  flex-wrap: wrap;
}

.status-btn {
  font-size: 24rpx;
  padding: 0 24rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  margin-right: 12rpx;
  margin-bottom: 10rpx;
  background: #f0f2f5;
  color: #4a5568;
  line-height: 1;
}

.status-btn.active {
  background: #1a365d;
  color: #ffffff;
}

/* 加载中 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 5rpx solid #e0e4ea;
  border-top-color: #1a365d;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #6b7280;
}

/* 空状态 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 0;
}

.empty-icon-box {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #e8ecf1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  font-size: 48rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #6b7280;
}
