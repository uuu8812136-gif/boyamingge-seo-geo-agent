/* 登录页 · 博雅敏格品牌色 #1a365d */
.login-page {
  min-height: 100vh;
  background: #1a365d;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
  box-sizing: border-box;
}

/* LOGO 区域 */
.logo-wrap {
  margin-top: 160rpx;
  margin-bottom: 72rpx;
  text-align: center;
}

.logo-text {
  font-size: 52rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 6rpx;
}

.logo-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 4rpx;
}

/* 登录卡片 */
.card {
  width: 100%;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 48rpx 36rpx;
  box-sizing: border-box;
}

.form-item {
  margin-bottom: 28rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  border: 2rpx solid #dfe3ea;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #1a2332;
  background: #f8f9fb;
}

.placeholder {
  color: #8c95a6;
  font-size: 28rpx;
}

/* 登录按钮 */
.btn-login {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  background: #1a365d;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  letter-spacing: 4rpx;
}

.btn-loading {
  background: #4a6a94;
  color: rgba(255, 255, 255, 0.7);
}

/* 底部提示 */
.tip {
  margin-top: 56rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
}
