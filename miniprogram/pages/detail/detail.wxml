<view class="detail-page">
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <view class="loading-text">加载中...</view>
  </view>

  <block wx:elif="{{detail}}">
    <view class="head-card">
      <view class="head-title">{{detail.title}}</view>
      <view class="head-meta">
        <text class="tag tag-city" wx:if="{{detail.city}}">{{detail.city}}</text>
        <text class="tag tag-platform" wx:if="{{detail.platform}}">{{detail.platform}}</text>
        <text class="tag tag-type" wx:if="{{detail.content_type}}">{{detail.content_type}}</text>
        <text class="tag tag-eeat" wx:if="{{detail.eeat_score}}">EEAT {{detail.eeat_score}}</text>
      </view>
    </view>

    <view class="section-card" wx:if="{{eeatDimensions.length}}">
      <view class="section-title">EEAT 质量评分</view>
      <view wx:for="{{eeatDimensions}}" wx:key="key" style="margin-bottom:20rpx;">
        <view style="display:flex;justify-content:space-between;margin-bottom:8rpx;">
          <text style="font-size:24rpx;color:#5a6475;">{{item.label}}</text>
          <text style="font-size:24rpx;font-weight:600;color:{{item.color}};">{{item.score}}分</text>
        </view>
        <view style="height:8rpx;background:#e8ecf1;border-radius:4rpx;overflow:hidden;">
          <view style="height:100%;border-radius:4rpx;width:{{item.score}}%;background:{{item.color}};"></view>
        </view>
      </view>
    </view>

    <view class="section-card" wx:if="{{detail.model_used}}">
      <view class="section-title">生成信息</view>
      <view style="font-size:26rpx;color:#5a6475;">模型：<text style="color:#1a365d;font-weight:500;">{{detail.model_used}}</text></view>
    </view>

    <view class="section-card">
      <view class="section-title">内容正文</view>
      <view class="content-body">{{detail.markdown}}</view>
    </view>

    <view style="height:160rpx;"></view>

    <!-- 底部操作栏 - 用 view 替代 button 彻底控制间距 -->
    <view class="action-bar" wx:if="{{detail.status === 'pending' || detail.status === 'package_ready'}}">
      <view class="btn-reject" bindtap="onReject">驳回</view>
      <view class="btn-spacer"></view>
      <view class="btn-confirm" bindtap="onConfirm">确认发布</view>
    </view>

    <view class="status-bar" wx:elif="{{detail.status === 'confirmed'}}">
      ✓ 该内容已确认，正在发布中
    </view>
    <view class="status-bar" wx:elif="{{detail.status === 'rejected'}}" style="color:#dc2626;">
      ✕ 该内容已驳回
    </view>
    <view class="status-bar" wx:elif="{{detail.status === 'published'}}" style="color:#065f46;">
      ✓ 该内容已发布
    </view>
  </block>
</view>
