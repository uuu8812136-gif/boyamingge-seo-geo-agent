/* 内容详情页 · 博雅敏格品牌色 #1a365d */
.detail-page {
  min-height: 100vh;
  background: #f0f2f5;
  padding-bottom: 40rpx;
}

/* 头部卡片 */
.head-card {
  background: #1a365d;
  padding: 40rpx 32rpx 36rpx;
  color: #ffffff;
}

.head-title {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.4;
}

.head-meta {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
}

.head-meta .tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  margin-right: 10rpx;
  margin-bottom: 8rpx;
  display: inline-block;
}

.head-meta .tag-city { background: rgba(255,255,255,0.15); color: #fff; }
.head-meta .tag-platform { background: rgba(67,181,129,0.3); color: #a7f3d0; }
.head-meta .tag-type { background: rgba(245,158,11,0.3); color: #fde68a; }
.head-meta .tag-eeat { background: rgba(139,92,246,0.3); color: #ddd6fe; }

/* 区块卡片 */
.section-card {
  margin: 20rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(26, 54, 93, 0.05);
}

/* 标题 - 用背景色块替代禁用的 side-stripe border */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a2332;
  margin-bottom: 20rpx;
  padding: 8rpx 16rpx;
  background: #f0f4fa;
  border-radius: 6rpx;
}

.content-body {
  font-size: 28rpx;
  color: #334155;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 底部操作栏 - 用 view 替代 button，彻底控制间距 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}

.btn-reject {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  color: #dc2626;
  background: #fef2f2;
  border-radius: 16rpx;
}

.btn-spacer {
  width: 24rpx;
  flex-shrink: 0;
}

.btn-confirm {
  flex: 2;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  background: #1a365d;
  border-radius: 16rpx;
}

/* 已处理状态条 */
.status-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  text-align: center;
  font-size: 28rpx;
  color: #8c95a6;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}

/* 加载 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 5rpx solid #e0e4ea;
  border-top-color: #1a365d;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #6b7280;
}
